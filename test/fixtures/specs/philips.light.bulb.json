{
  "model": "philips.light.bulb",
  "source": "homebridge-miot 2.0.0 (MIT), lib/modules/*/devices/philips.light.bulb.js",
  "spec": {
    "type": "urn:miot-spec-v2:device:light:0000A001:philips-bulb:1",
    "description": "Xiaomi Philips Smart LED",
    "services": [
      {
        "iid": 2,
        "type": "urn:miot-spec-v2:service:light:00007802:philips-bulb:1",
        "description": "Light",
        "properties": [
          {
            "iid": 1,
            "type": "urn:miot-spec-v2:property:on:00000006:philips-bulb:1",
            "description": "Switch Status",
            "format": "bool",
            "access": ["read", "write", "notify"]
          },
          {
            "iid": 2,
            "type": "urn:miot-spec-v2:property:brightness:0000000D:philips-bulb:1",
            "description": "Brightness",
            "format": "uint8",
            "access": ["read", "write", "notify"],
            "unit": "percentage",
            "value-range": [1, 100, 1]
          },
          {
            "iid": 3,
            "type": "urn:miot-spec-v2:property:mode:00000008:philips-bulb:1",
            "description": "Mode",
            "format": "uint8",
            "access": ["read", "write", "notify"],
            "value-list": [
              {
                "value": 1,
                "description": "Day"
              },
              {
                "value": 2,
                "description": "Night"
              },
              {
                "value": 3,
                "description": "Tv"
              },
              {
                "value": 4,
                "description": "Warmth"
              }
            ]
          },
          {
            "iid": 4,
            "type": "urn:miot-spec-v2:property:color-temperature:0000000F:philips-bulb:1",
            "description": "Color Temperature",
            "format": "uint32",
            "access": ["read", "write", "notify"],
            "unit": "kelvin",
            "value-range": [3000, 5700, 1]
          }
        ]
      }
    ]
  }
}
