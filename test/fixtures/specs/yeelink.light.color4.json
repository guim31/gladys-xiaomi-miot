            "unit": "percentage",
            "value-range": [1, 100, 1]
          },
          {
            "iid": 3,
            "type": "urn:miot-spec-v2:property:color-temperature:0000000F:yeelink-color4:1",
            "description": "Color Temperature",
            "format": "uint32",
            "access": ["read", "write", "notify"],
            "unit": "kelvin",
            "value-range": [1700, 6500, 1]
          },
          {
            "iid": 4,
            "type": "urn:miot-spec-v2:property:color:0000000E:yeelink-color4:1",
            "description": "Color",
            "format": "uint32",
            "access": ["read", "write", "notify"],
            "unit": "rgb",
            "value-range": [1, 16777215, 1]
          },
          {
            "iid": 5,
            "type": "urn:miot-spec-v2:property:mode:00000008:yeelink-color4:1",
            "description": "Mode",
            "format": "uint8",
            "access": ["read", "write", "notify"],
            "value-list": [
              {
                "value": 1,
                "description": "Color"
              },
              {
                "value": 2,
                "description": "Day"
              }
            ]
          }
        ],
        "actions": [
          {
            "iid": 1,
            "type": "urn:miot-spec-v2:action:toggle:00002811:yeelink-color4:1",
            "description": "Toggle",
            "in": [],
            "out": []
          }
        ]
      },
      {
        "iid": 3,
        "type": "urn:yeelink-spec:service:light-extension:00000001:yeelink-color4:1",
