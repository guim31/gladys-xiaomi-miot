            "type": "urn:miot-spec-v2:property:on:00000006:yeelink-color4:1",
            "description": "Switch Status",
            "format": "bool",
            "access": ["read", "write", "notify"]
          },
          {
            "iid": 2,
            "type": "urn:miot-spec-v2:property:brightness:0000000D:yeelink-color4:1",
